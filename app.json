{
  "expo": {
    "name": "독파민",
    "slug": "dokpamine",
    "scheme": "dokpamine",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.dokpamine.app",
      "versionCode": 2
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-camera",
        {
          "cameraPermission": "책 바코드를 스캔하려면 카메라 접근을 허용해 주세요.",
          "recordAudioAndroid": false
        }
      ],
      "expo-notifications",
      "expo-sqlite",
      "expo-secure-store"
    ]
  }
}
